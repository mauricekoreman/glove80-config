        skq: stickey_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            release-after-ms = <1000>;
            bindings = <&kp>;
            quick-release;
            ignore-modifiers;
        };

        tdsc: tap_dance_shift_capsword {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&skq LSHIFT>, <&caps_word>;
            tapping-term-ms = <200>;
        };

        holdtapdance: holdtapdance {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&tdsc>;
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
        };
    };
};

